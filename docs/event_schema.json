{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Contract - Sovereign AI Workbench",
  "description": "Frozen contract for all real-time events pushed over WebSockets and Redis.",
  "models": {
    "EventEnvelope": {
      "type": "object",
      "required": ["id", "event_type", "occurred_at", "source", "correlation_id", "payload"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "event_type": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "task_id": { "type": ["string", "null"], "format": "uuid" },
        "agent_run_id": { "type": ["string", "null"], "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "causation_id": { "type": ["string", "null"], "format": "uuid" },
        "payload": { "type": "object" },
        "schema_version": { "type": "integer", "default": 1 }
      }
    }
  },
  "event_types": [
    "task.created",
    "task.status.changed",
    "agent.step.started",
    "agent.step.completed",
    "agent.step.failed",
    "tool.execution.started",
    "tool.execution.completed",
    "tool.execution.failed",
    "resource.metric.sampled"
  ]
}